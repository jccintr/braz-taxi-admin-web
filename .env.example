# URL pública da API em produção (sem barra no final). Em desenvolvimento deixe vazio: o Vite faz proxy de /api.
VITE_API_URL=https://xxx.server.com
# (só dev) para onde o proxy do Vite aponta: a API local ou a de produção
VITE_API_PROXY=http://localhost:3000
# Centro inicial dos mapas quando ainda não há dados (lat,lng) — padrão: Brazópolis/MG
# VITE_MAP_CENTER=-22.4740,-45.6142
# (opcional) chave gratuita da CARTO (carto.com/basemaps/apikey): deixa o mapa escuro com o estilo Dark Matter.
# Sem ela, o tema escuro usa o OpenStreetMap escurecido.
# VITE_CARTO_KEY=
